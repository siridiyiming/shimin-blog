HOST=127.0.0.1
PORT=8000
DATA_DIR=./data
DATABASE_URL=mysql+pymysql://blog_user:CHANGE_ME@127.0.0.1:3306/siriblog?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://blog_user:CHANGE_ME@127.0.0.1:3306/siriblog_test?charset=utf8mb4
TEST_RESTORE_DATABASE_URL=mysql+pymysql://blog_user:CHANGE_ME@127.0.0.1:3306/siriblog_restore_test?charset=utf8mb4
TEST_RESTORE_DATA_DIR=./data/restore-test
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# 正式运行填写博客自己的 HTTPS 地址；本地开发不需要设置。
# PUBLIC_ORIGIN=https://blog.example.com
# 仅在已配置的本机反向代理后设为 1，不能信任任意来源的代理头。
TRUST_PROXY=0
